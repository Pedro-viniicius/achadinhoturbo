{
  "name": "achadinhoturbo",
  "version": "1.0.0",
  "private": true,
  "description": "achadinhoturbo: disparador pessoal de ofertas do Mercado Livre (Central de Afiliados) para grupos de WhatsApp, com várias etiquetas, análise de grupos e rotacionador de links.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "simular": "node --disable-warning=ExperimentalWarning src/server.js --simular",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "senha": "node --disable-warning=ExperimentalWarning scripts/senha.js",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "backup:instalar": "node --disable-warning=ExperimentalWarning scripts/backup-instalar.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "express": "^5.1.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  }
}
