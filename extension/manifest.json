{
  "manifest_version": 3,
  "name": "achadinhoturbo · Conector",
  "version": "1.2.0",
  "description": "Busca ofertas da sua Central de Afiliados do Mercado Livre e gera links meli.la com a sua etiqueta. Nenhum cookie sai do navegador.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.mercadolivre.com.br/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "achadinhoturbo"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
