{
  "manifest_version": 3,
  "name": "achadinhoturbo · Conector",
  "version": "1.6.0",
  "description": "Busca ofertas da sua Central de Afiliados do Mercado Livre, gera links de afiliado (meli.la e s.shopee.com.br) e confere preço e estoque no Mercado Livre com a sua sessão. Nenhum cookie sai do navegador.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://affiliate.shopee.com.br/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "achadinhoturbo"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
